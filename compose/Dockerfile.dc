# Samba Active Directory Domain Controller. Samba AD implements the same protocols as Windows AD:
# Kerberos, LDAP, DNS and SMB, so the same tooling and the same concepts apply.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      samba samba-dsdb-modules samba-vfs-modules smbclient ldb-tools ldap-utils krb5-user \
      winbind libpam-winbind libnss-winbind \
      dnsutils iproute2 procps python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY provision_dc.sh /usr/local/bin/provision_dc.sh
RUN chmod +x /usr/local/bin/provision_dc.sh
ENTRYPOINT ["/usr/local/bin/provision_dc.sh"]
